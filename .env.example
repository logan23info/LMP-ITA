# Copy this to .env and fill in your values
# NEVER commit .env to GitHub

# Hugging Face token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# Your HF username for saving the fine-tuned adapter
HF_USERNAME=your_hf_username

# LLM backend: ollama | hf_api | local_hf
AUDIT_LLM_BACKEND=ollama

# LoRA adapter repo (after fine-tuning)
LORA_ADAPTER_ID=your_hf_username/audit-llm-adapter

# ChromaDB path (local persistent storage)
CHROMA_PATH=./chroma_db
